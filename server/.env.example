# Google Workspace SSO — Authorized redirect URI: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_ALLOWED_DOMAINS=vaschools.edu.vn,hcm.vaschools.edu.vn
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Email (phân tách bởi dấu phẩy) được gán quyền superadmin mỗi lần đăng nhập
SUPERADMIN_EMAILS=khoana@hcm.vaschools.edu.vn

# Origin của frontend Vite dev server — dùng cho CORS + redirect sau login
FRONTEND_URL=http://localhost:5173
FRONTEND_LOGIN_PATH=/login
FRONTEND_HOME_PATH=/

PORT=4000
SESSION_COOKIE_NAME=va_ebr_session
# true khi chạy sau HTTPS thật (production); để false khi dev qua http://localhost
SECURE_COOKIE=false

# MySQL — database + user riêng, không dùng root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=va_ebr
DB_USER=va_ebr_app
DB_PASSWORD=change-me
